{
  "permissions": {
    "allow": [
      "Bash(uv run ruff:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run pre-commit:*)",
      "Bash(uv sync:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/format-python.py \"$FILE_PATH\""
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/lint-python.py \"$FILE_PATH\""
          }
        ]
      }
    ]
  }
}
